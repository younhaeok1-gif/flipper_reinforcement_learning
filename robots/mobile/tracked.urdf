  <joint name="imu_joint" type="fixed">
    <parent link="body"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.085"/>
  </joint>
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="6.666666666666668e-07" ixy="0" ixz="0" iyy="6.666666666666668e-07" iyz="0" izz="6.666666666666668e-07"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>
  <joint name="rgb_camera_joint" type="fixed">
    <parent link="body"/>
    <child link="rgb_camera_link"/>
    <origin rpy="0 0 0" xyz="0.27999999999999997 0.06 0.10500000000000001"/>
  </joint>
  <link name="rgb_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="4.833333333333334e-06" ixy="0" ixz="0" iyy="1.3333333333333336e-06" iyz="0" izz="4.833333333333334e-06"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <gazebo reference="rgb_camera_link">
    <sensor name="front_rgb_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>front/rgb</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
    <sensor name="front_depth_camera" type="depth_camera">
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>front/depth</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="body"/>
    <child link="depth_camera_link"/>
    <origin rpy="0 0.8 0" xyz="0.31 0.0 0.135"/>
  </joint>
  <link name="depth_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="4.833333333333334e-06" ixy="0" ixz="0" iyy="1.3333333333333336e-06" iyz="0" izz="4.833333333333334e-06"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>
  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>depth_camera</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="depth_camera_controller">
        <frame_name>depth_camera_link</frame_name>
        <min_depth>0.01</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
    <sensor name="depth_camera_rgb" type="camera">
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>depth_camera/rgb</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
